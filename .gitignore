# private EPUB fixture corpus - never commit copyrighted source or derived
# paid content; see fixtures/epub/README.md
fixtures/epub/private/
fixtures/epub/manifest.local.json

# Belt-and-braces: the risk is extension-shaped, not just path-shaped - a
# stray .epub anywhere else in the tree (e.g. `git add fixtures/epub` from a
# misplaced file) must not become committable by accident. Re-admit a
# deliberate public-domain fixture with a `!path/to/file.epub` negation.
*.epub

# superpowers SDD workspace (ledgers, briefs, review packages, scratch configs)
.superpowers/

cmd.txt

