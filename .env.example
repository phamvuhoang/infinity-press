# Copy this file to .env.local. For the local stack, take keys from `supabase status`.
# For a hosted project, use the Supabase Connect panel and HTTPS URLs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
APP_ENV=local
SITE_URL=http://127.0.0.1:3000
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# disabled | simulator | manual. Press takes payments by manual bank transfer (VND only) and has no
# SePay integration: a leftover PAYMENT_PROVIDER=sepay stops the app from starting. production refuses
# simulator.
PAYMENT_PROVIDER=simulator
# Signs simulated payment events. At least 32 characters. Required when PAYMENT_PROVIDER=simulator.
PAYMENT_SIMULATOR_SECRET=replace-with-at-least-32-random-characters
# Required when PAYMENT_PROVIDER=manual: Press's OWN payee account, never another business's. Napas
# bank code, e.g. 970436 for Vietcombank.
BANK_TRANSFER_BANK_CODE=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
READER_SESSION_TTL_SECONDS=900
# Required by the Playwright suite (not by the app). Mailpit ships with the local Supabase stack;
# `supabase status` prints it as MAILPIT_URL. The suite refuses to start without it rather than
# skipping the specs that read authentication emails.
E2E_MAILPIT_URL=http://127.0.0.1:54324
# Also required by the Playwright suite: the local Postgres (`supabase status` prints it as DB_URL).
# The operations spec writes one fixture row that no API role may write. Loopback only.
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# S5 email and operations. Optional outside production; when EMAIL_PROVIDER is set its own
# requirements still apply (resend needs a key and a valid sender). "test" uses a no-network
# adapter and is only allowed when APP_ENV is local or test. Production requires resend, a key,
# a valid sender, a valid operator email, and a worker secret of at least 32 characters.
EMAIL_PROVIDER=test
# Resend API key. Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=re_your-resend-api-key
# Sender address on the configured Resend domain. May be "Name <addr@domain>". Required when
# EMAIL_PROVIDER=resend.
EMAIL_FROM=Infinity Books Press <books@example.com>
# Operator inbox for book-ready delivery failures and other operational alerts. Required in
# production.
OPS_ALERT_EMAIL=operator@example.com
# Authenticates the scheduled worker route (pg_cron -> Next.js). At least 32 random characters.
# Required in production.
OPS_WORKER_SECRET=replace-with-at-least-32-random-characters
