{
  "name": "infinity-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "ebook": "tsx scripts/ebook.ts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run check:prerender",
    "check:prerender": "tsx scripts/assert-prerendered-routes.ts",
    "check:prerender:content": "tsx scripts/assert-prerendered-routes.ts --require-content",
    "check:full": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@readium/navigator": "^2.10.0",
    "@readium/navigator-html-injectables": "^2.8.0",
    "@readium/shared": "^2.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
